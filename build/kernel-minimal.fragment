# Pi Zero W USB-only authenticator kernel overlay.
# The raspberrypi0w_defconfig supplies the BCM2835 platform, SD/MMC,
# initramfs, ext4, and the DWC2 peripheral controller.  Everything below is
# explicitly removed because this image has no network, host USB, display,
# camera, audio, or wireless runtime.

# Leave module support enabled so unrelated defconfig `m` options remain
# out-of-tree modules instead of being promoted into the built-in zImage.
CONFIG_MODULES=y
CONFIG_WIRELESS=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n
CONFIG_WLAN=n
CONFIG_RFKILL=n
CONFIG_BLUETOOTH=n
CONFIG_BT=n
CONFIG_NET=n
CONFIG_INET=n
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_NETFILTER_ADVANCED=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_IRDA=n
CONFIG_NFC=n
CONFIG_SCTP=n

CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_BACKLIGHT=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_VIDEO_DEV=n
CONFIG_V4L2_MEM2MEM_DEV=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_USB_HID=n

# USB peripheral-only path.  Keep DWC2, libcomposite, ConfigFS, and HID;
# remove host controllers, host protocol drivers, and alternate gadgets.
CONFIG_USB_DWC2_DUAL_ROLE=n
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_HOST=n
CONFIG_USB_DWCOTG=n
CONFIG_USB_ACM=n
CONFIG_USB_PRINTER=n
CONFIG_USB_WDM=n
CONFIG_USBIP_CORE=n
CONFIG_USBIP_HOST=n
CONFIG_USBIP_VUDC=n
CONFIG_USB_NET_DRIVERS=n
CONFIG_USB_STORAGE=n
CONFIG_USB_MASS_STORAGE=n
CONFIG_USB_SERIAL=n
CONFIG_USB_F_ACM=n
CONFIG_USB_F_MASS_STORAGE=n
CONFIG_USB_F_ECM=n
CONFIG_USB_F_EEM=n
CONFIG_USB_F_NCM=n
CONFIG_USB_F_RNDIS=n
CONFIG_USB_F_SUBSET=n
CONFIG_USB_U_SERIAL=n
CONFIG_USB_U_ETHER=n
CONFIG_USB_ETH=n
CONFIG_USB_G_MULTI=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_G_PRINTER=n
CONFIG_USB_G_ACM_MS=n
CONFIG_USB_G_HID=n
CONFIG_USB_ZERO=n
CONFIG_USB_TEST=n
CONFIG_USB_CONFIGFS_NCM=n
CONFIG_USB_CONFIGFS_ECM=n
CONFIG_USB_CONFIGFS_ECM_SUBSET=n
CONFIG_USB_CONFIGFS_RNDIS=n
CONFIG_USB_CONFIGFS_EEM=n
CONFIG_USB_CONFIGFS_F_HID=y
# CONFIG_USB_CONFIGFS_SERIAL is not set
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_OBEX is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_CONFIGFS_F_LB_SS is not set
# CONFIG_USB_CONFIGFS_F_PRINTER is not set
CONFIG_USB_F_HID=y
CONFIG_USB_GADGETFS=n
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_GADGET=y

CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_SATA_AHCI_PLATFORM=n
CONFIG_BLK_DEV_LOOP=n
CONFIG_MD=n
CONFIG_BCACHE=n
CONFIG_BLK_DEV_NBD=n
CONFIG_BLK_DEV_RAM=n
CONFIG_BLK_DEV_DRBD=n
CONFIG_BLK_DEV_RBD=n

CONFIG_CPU_FREQ=n
CONFIG_PM=n
CONFIG_CPU_IDLE=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_THERMAL=n
CONFIG_WATCHDOG=n
CONFIG_RTC_CLASS=n
# Keep the small LED class core because the bcmrpi defconfig enables the
# activity-power trigger; no LED hardware drivers are enabled for runtime.
CONFIG_LEDS_CLASS=y
CONFIG_GPIO_SYSFS=n

CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_FS=n
CONFIG_DEBUG_INFO=n
CONFIG_KALLSYMS=n
CONFIG_TRACING=n
CONFIG_FTRACE=n
CONFIG_PROFILING=n
CONFIG_BPF=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_AUDIT=n
CONFIG_SECCOMP=n

# Keep only the filesystems and pseudo-filesystems used by the initramfs and
# persistent credential partition.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=n
CONFIG_EXT4_FS_SECURITY=n
CONFIG_EXT2_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_VFAT_FS=n
CONFIG_MSDOS_FS=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_OVERLAY_FS=n
CONFIG_AUTOFS_FS=n
CONFIG_BCACHEFS_FS=n
CONFIG_BLK_DEBUG_FS=n
CONFIG_ECRYPT_FS=n
CONFIG_EROFS_FS=n
CONFIG_EXFAT_FS=n
CONFIG_GFS2_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_ISO9660_FS=n
CONFIG_JFFS2_FS=n
CONFIG_JFS_FS=n
CONFIG_NILFS2_FS=n
CONFIG_NTFS3_FS=n
CONFIG_REISERFS_FS=n
CONFIG_UBIFS_FS=n
CONFIG_UDF_FS=n
CONFIG_FUSE_FS=n
CONFIG_SQUASHFS=n
CONFIG_CRAMFS=n
CONFIG_ROMFS_FS=n
CONFIG_SYSV_FS=n
CONFIG_UFS_FS=n
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
CONFIG_CONFIGFS_FS=y
CONFIG_USB_F_FS=n
CONFIG_USB_CONFIGFS_F_FS=n

# Unused buses and Raspberry Pi multimedia/peripheral subsystems.
CONFIG_MTD=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_W1=n
CONFIG_SERIO=n
CONFIG_EEPROM_AT24=n
CONFIG_EEPROM_AT25=n
CONFIG_EEPROM_93CX6=n
CONFIG_POWER_SUPPLY=n
CONFIG_HWMON=n
CONFIG_MFD_CORE=n
CONFIG_REGULATOR=n
CONFIG_IIO=n
CONFIG_PWM=n
CONFIG_NVMEM=n
CONFIG_VCHIQ_CDEV=n
CONFIG_BCM2835_VCHIQ=n
CONFIG_BCM2835_VCHIQ_MMAL=n
CONFIG_BCM_VCIO=n
CONFIG_BCM_VC_SM_CMA=n
CONFIG_BCM_VIDEOCORE=n
CONFIG_DMABUF_HEAPS=n
CONFIG_VIRTIO_MENU=n
CONFIG_VHOST_MENU=n
CONFIG_MEDIA_CEC_SUPPORT=n
CONFIG_BACKLIGHT_CLASS_DEVICE=n
CONFIG_BACKLIGHT_PWM=n
CONFIG_BACKLIGHT_RPI=n

# Hardware RNG is useful for early cryptographic seeding on this SoC.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_BCM2835=y
