CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_HOST=n
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
CONFIG_GPIO_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_CMDLINE="loglevel=7 root=/dev/ram0 rdinit=/etc/init.d/S01pifido"
