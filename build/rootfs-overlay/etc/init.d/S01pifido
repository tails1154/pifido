#!/bin/sh
set -u

PATH=/sbin:/bin:/usr/sbin:/usr/bin
DATA=/data/pifido

echo 'PiFIDO init: mounts' >/dev/console 2>/dev/null || true
mountpoint -q /sys || mount -t sysfs sysfs /sys || true
mountpoint -q /proc || mount -t proc proc /proc || true
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev || true
mountpoint -q /sys/kernel/config || {
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config || true
}

# Remove any stale composite gadget left by an interrupted authenticator start.
# ConfigFS keeps an unbound gadget around after a process crash; leaving its
# function links in place makes the next bind fail with EBUSY/EINVAL.
for OLD in /sys/kernel/config/usb_gadget/*; do
    [ -d "$OLD" ] || continue
    # ConfigFS requires an actual write (normally a newline) to detach the
    # gadget.  A zero-byte printf succeeds but leaves the UDC claimed, which
    # makes the next authenticator start fail with EBUSY.
    [ -e "$OLD/UDC" ] && printf '\n' > "$OLD/UDC" 2>/dev/null || true
    [ -L "$OLD/configs/c.1/hid.usb0" ] && unlink "$OLD/configs/c.1/hid.usb0" 2>/dev/null || true
    [ -L "$OLD/configs/c.1/ffs.authui" ] && unlink "$OLD/configs/c.1/ffs.authui" 2>/dev/null || true
    rmdir "$OLD/configs/c.1/strings/0x409" 2>/dev/null || true
    rmdir "$OLD/configs/c.1/strings" 2>/dev/null || true
    rmdir "$OLD/configs/c.1" 2>/dev/null || true
    rmdir "$OLD/functions/hid.usb0" 2>/dev/null || true
    rmdir "$OLD/functions/ffs.authui" 2>/dev/null || true
    rmdir "$OLD/functions" 2>/dev/null || true
    rmdir "$OLD/strings/0x409" 2>/dev/null || true
    rmdir "$OLD/strings" 2>/dev/null || true
    rmdir "$OLD" 2>/dev/null || true
done
sleep 1

mount -a 2>/dev/null || true
mkdir -p /dev/ffs-authui
# FunctionFS/WebUSB management is optional and is deliberately not mounted
# during boot; CTAPHID must remain independent of it.
mkdir -p /data
if ! mountpoint -q /data; then
    for i in $(seq 1 30); do
        if [ -b /dev/mmcblk0p2 ] && mount -t ext4 -o noatime,commit=1 /dev/mmcblk0p2 /data 2>/tmp/pifido-mount.err; then
            break
        fi
        sleep 1
    done
fi
if ! mountpoint -q /data; then
    echo 'PiFIDO init: DATA MOUNT FAILED' >/dev/console 2>/dev/null || true
    cat /tmp/pifido-mount.err >/dev/console 2>/dev/null || true
else
    echo 'PiFIDO init: data mounted' >/dev/console 2>/dev/null || true
fi

mkdir -p "$DATA"
chmod 700 "$DATA"
if [ ! -e "$DATA/credentials.json" ]; then
    printf '%s\n' '{"credentials":[]}' > "$DATA/credentials.json"
    chmod 600 "$DATA/credentials.json"
    sync
fi

while :; do
    UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
    if [ -n "$UDC" ]; then
        echo "PiFIDO init: UDC=$UDC" >/dev/console 2>/dev/null || true
        break
    fi
    echo 'PiFIDO init: waiting for USB device controller' >/dev/console 2>/dev/null || true
    sleep 1
done

echo 'PiFIDO init: starting native authenticator' >/dev/console 2>/dev/null || true
if ! /usr/lib/pifido/setup-hid-gadget; then
    echo 'PiFIDO init: USB HID gadget setup failed' >/dev/console 2>/dev/null || true
    while :; do sleep 60; done
fi

if [ ! -e /dev/hidg0 ]; then
    echo 'PiFIDO init: /dev/hidg0 was not created' >/dev/console 2>/dev/null || true
    while :; do sleep 60; done
fi

PIFIDO_STORE="$DATA/credentials.json"
export PIFIDO_STORE
/usr/bin/pifido-native --hid /dev/hidg0 2>&1 | tee "$DATA/native.log" >/dev/console
RC=$?
echo "PiFIDO native authenticator exited rc=$RC; halted for diagnostics" >/dev/console 2>/dev/null || true
while :; do sleep 60; done
